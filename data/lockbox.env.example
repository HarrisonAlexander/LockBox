# Copy to lockbox.env to use. KEY=VALUE, one per line; # starts a comment.
# Read by LockBox.cmd (the GUI) and sbx.cmd. A variable that is
# already set in the environment wins over this file.

# Where runs, reports, screenshots and the redistributable cache go.
# Default: data\home inside this LockBox. Point it at a local disk if the
# LockBox lives on slow or read-only media.
# SANDBOX_MCP_HOME=C:\Temp\lockbox-home

# Claude windows LockBox opens use the plain monochrome look (NO_COLOR=1). Set this to keep colours.
# LOCKBOX_CLAUDE_COLOR=1
